---
import { Image } from "astro:assets";

const { title, description, image, tags } = Astro.props;
---

<article
    class="
        project
        group
        relative
        min-h-[380px]
        overflow-hidden
        rounded-3xl
        border border-gray-400/20
        bg-slate-950/70
    "
>
    <div class="overflow-hidden">
        <Image
            src={image}
            alt={`Vista previa del proyecto ${title}`}
            class="
                h-[210px]
                w-full
                object-cover
                transition-transform
                duration-500
                group-hover:scale-[1.03]
            "
        />
    </div>

    <div class="flex h-full flex-col px-6 py-6">
        <div>
            <span
                class="
                    text-[0.7rem]
                    font-semibold
                    uppercase
                    tracking-[0.25em]
                    text-blue-300
                "
            >
                Web project
            </span>

            <h3
                class="
                    mt-2
                    text-xl
                    font-bold
                    text-slate-100
                "
            >
                {title}
            </h3>

            <p
                class="
                    mt-3
                    text-sm
                    leading-7
                    text-slate-400
                "
            >
                {description}
            </p>
        </div>

        <div class="mt-6 flex flex-wrap gap-2">
            {
                tags.map((tag: string) => (
                    <span
                        class="
                            rounded-lg
                            border border-violet-400/20
                            bg-violet-500/8
                            px-3 py-1.5
                            text-xs
                            font-medium
                            text-blue-300
                        "
                    >
                        {tag}
                    </span>
                ))
            }
        </div>
    </div>
</article>

<style>
    .project {
        transition:
            transform 0.3s ease,
            border-color 0.3s ease,
            box-shadow 0.3s ease,
            background-color 0.3s ease;
    }

    .project:hover {
        transform: translateY(-6px);
        border-color: rgba(167, 139, 250, 0.4);
        background-color: rgba(15, 23, 42, 0.9);

        box-shadow:
            0 20px 50px rgba(2, 6, 23, 0.4),
            0 0 30px rgba(139, 92, 246, 0.08);
    }
</style>