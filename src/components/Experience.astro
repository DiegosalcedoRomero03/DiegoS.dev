---
import { experience } from "../data/experience";
---

<section
    id="experience"
    class="relative z-10 overflow-hidden px-4 py-24"
>
    <div class="mx-auto w-full max-w-6xl">

        <div class="mb-12 text-center">
            <span
                class="
                    text-xs
                    font-semibold
                    uppercase
                    tracking-[0.35em]
                    text-[rgb(var(--rgb-accent-blue))]
                "
            >
                Professional journey
            </span>

            <h2 class="mt-3 text-3xl font-bold text-[rgb(var(--rgb-text-primary))] md:text-4xl">
                Experience
            </h2>

            <p class="mx-auto mt-3 max-w-2xl text-[rgb(var(--rgb-text-secondary))]">
                My professional experience developing business software,
                web applications, and custom solutions.
            </p>
        </div>

        <div class="experience-timeline">

            {
                experience.map((job) => (

                    <article class="experience-item">

                        <div class="experience-period">
                            {job.period}
                        </div>

                        <div class="experience-marker"></div>

                        <div class="experience-card">

                            <div class="experience-header">

                                <div>
                                    <h3>
                                        {job.role}
                                    </h3>

                                    <p class="company">
                                        {job.company}
                                    </p>
                                </div>

                                <span class="location">
                                    {job.location}
                                </span>

                            </div>

                            <p class="description">
                                {job.description}
                            </p>

                            <ul>

                                {
                                    job.responsibilities.map((item) => (

                                        <li>{item}</li>

                                    ))
                                }

                            </ul>

                            <div class="tech-list">

                                {
                                    job.technologies.map((tech) => (

                                        <span class="tech-tag">
                                            {tech}
                                        </span>

                                    ))
                                }

                            </div>

                        </div>

                    </article>

                ))
            }

        </div>

    </div>

</section>

<style>
    .experience-timeline{

    position:relative;

    display:flex;
    flex-direction:column;

    gap:3rem;
}

.experience-timeline::before{

    content:"";

    position:absolute;

    top:0;
    bottom:0;

    left:8rem;

    width:2px;

    background:
    linear-gradient(
        rgb(var(--rgb-accent-blue-strong)),
        rgb(var(--rgb-accent-blue-strong) / 0.15)
    );

}

.experience-item{

    display:grid;

    grid-template-columns:

    7rem
    2rem
    1fr;

    gap:2rem;

    position:relative;
}

.experience-period{

    text-align:right;

    font-size:.75rem;

    font-weight:600;

    color:rgb(var(--rgb-accent-blue-strong));

    padding-top:.4rem;
}
.experience-marker{

    width:14px;
    height:14px;

    border-radius:50%;

    background:rgb(var(--rgb-accent-blue-strong));

    margin-top:.4rem;

    box-shadow:

    0 0 18px
    rgb(var(--rgb-accent-blue-strong) / 0.7);
}
.experience-card{

    padding:2rem;

    border-radius:1.5rem;

    border:1px solid
    rgb(var(--rgb-accent-purple) / 0.15);

    background:
    rgb(var(--rgb-bg-base) / 0.7);

    transition:.3s;
}
.experience-card:hover{

    transform:translateY(-5px);

    border-color:
    rgb(var(--rgb-accent-blue-strong) / 0.3);

}
.experience-header{

    display:flex;

    justify-content:space-between;

    align-items:flex-start;

    gap:2rem;
}
.company{

    margin-top:.3rem;

    color:rgb(var(--rgb-accent-blue-strong));
}
.location{

    color:rgb(var(--rgb-text-muted));

    font-size:.85rem;
}
.description{

    margin-top:1.3rem;

    color:rgb(var(--rgb-text-secondary));

    line-height:1.8;
}
ul{

    margin-top:1.5rem;

    display:flex;

    flex-direction:column;

    gap:.75rem;

    color:rgb(var(--rgb-text-nav));
}
.tech-list{

    margin-top:2rem;

    display:flex;

    flex-wrap:wrap;

    gap:.6rem;
}
.tech-tag{

    padding:

    .35rem
    .8rem;

    border-radius:.6rem;

    background:
    rgb(var(--rgb-accent-purple-strong) / 0.08);

    border:
    1px solid
    rgb(var(--rgb-accent-purple) / 0.2);

    color:rgb(var(--rgb-accent-blue));

    font-size:.75rem;
}

</style>