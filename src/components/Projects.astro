---
import ProjectCard from "./ProjectCard.astro";
import { projects } from "../data/projects";
---

<section
    id="projects"
    class="
        relative z-10
        flex flex-col items-center justify-center
        bg-transparent
        px-4 pt-34 py-24
    "
>
    <div class="w-full max-w-6xl">
        <div class="mb-12 text-center">
            <span
                class="
                    text-xs font-semibold uppercase
                    tracking-[0.35em]
                    text-blue-300
                "
            >
                Selected work
            </span>

            <h2 class="mt-3 text-3xl font-bold text-white md:text-4xl">
                Projects I’ve worked on
            </h2>

            <p class="mx-auto mt-3 max-w-2xl text-slate-400">
                A selection of applications and projects where I have applied
                backend development, databases, and modern web technologies.
            </p>
        </div>

        <div
            class="
                grid
                grid-cols-[repeat(auto-fit,minmax(300px,1fr))]
                gap-6
            "
        >
            {
                projects.map((project) => (
                    <ProjectCard {...project} />
                ))
            }
        </div>
    </div>
</section>