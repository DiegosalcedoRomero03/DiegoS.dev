---
import Header from "./Header.astro"
import Hero from "./Hero.astro"
import ParticleBackground from "./ParticleBackground.astro"
import Projects from "./Projects.astro"
import AboutMe from "./AboutMe.astro"
import Footer from "./Footer.astro"
import SkillsCarousel from "./SkillsCarousel.astro"
import Experience from "./Experience.astro"
---

<section class="main-background">

    <Header />

    <Hero />

    <Projects />

    <SkillsCarousel />

    <Experience />

    <AboutMe />

    <Footer />

</section>

<style>

    .main-background {
        min-height: 100vh;
        position: relative;
        overflow: hidden;

        background:
            radial-gradient(
                circle at 15% 15%,
                rgba(124,58,237,.18),
                transparent 32%
            ),

            radial-gradient(
                circle at 85% 10%,
                rgba(37,99,235,.15),
                transparent 35%
            ),

            radial-gradient(
                circle at 50% 100%,
                rgba(96,165,250,.08),
                transparent 38%
            ),

            #020617;
    }

</style>