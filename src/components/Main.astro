---
import Header from "./Header.astro"
import Hero from "./Hero.astro"
import ParticleBackground from "./ParticleBackground.astro"
import Projects from "./Projects.astro"
import AboutMe from "./AboutMe.astro"
import Footer from "./Footer.astro"
import SkillsCarousel from "./SkillsCarousel.astro"
import Experience from "./Experience.astro"
---

<section class="main-background">

    <Header />

    <Hero />

    <Projects />

    <SkillsCarousel />

    <Experience />

    <AboutMe />

    <Footer />

</section>

<style>

    .main-background {
        min-height: 100vh;
        position: relative;
        overflow: hidden;

        background:
            radial-gradient(
                circle at 15% 15%,
                rgb(var(--rgb-accent-purple-deep) / var(--opacity-glow-1)),
                transparent 32%
            ),

            radial-gradient(
                circle at 85% 10%,
                rgb(var(--rgb-accent-blue-deep) / var(--opacity-glow-2)),
                transparent 35%
            ),

            radial-gradient(
                circle at 50% 100%,
                rgb(var(--rgb-accent-blue-strong) / var(--opacity-glow-3)),
                transparent 38%
            ),

            rgb(var(--rgb-bg-deep));
    }

</style>