<header id="header">
    <a href="#home" class="brand" aria-label="Go to home">
        <div class="brand-avatar" aria-hidden="true">
            DS
        </div>

        <div class="brand-copy">
            <p class="brand-name">Diego Salcedo</p>
            <p class="brand-role">Software Developer</p>
        </div>
    </a>

    <div class="header-actions">
        <nav aria-label="Main navigation">
            <a href="#home">Home</a>
            <a href="#projects">Projects</a>
            <a href="#experience">Experience</a>
            <a href="#about">About</a>
            <a href="#contact">Contact</a>
        </nav>

        <button
            id="theme-toggle"
            class="theme-toggle"
            type="button"
            aria-label="Toggle color theme"
        >
            <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="4"></circle>
                <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
            </svg>

            <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z"></path>
            </svg>
        </button>
    </div>

</header>

<script is:inline>
    (function () {
        var button = document.getElementById("theme-toggle");

        if (!button) return;

        button.addEventListener("click", function () {
            var root = document.documentElement;
            var isLight = root.getAttribute("data-theme") === "light";
            var next = isLight ? "dark" : "light";

            root.setAttribute("data-theme", next);
            localStorage.setItem("theme", next);
        });
    })();
</script>

<style>
    #header {
        position:fixed;
        left: 50%;
        top: 1rem;
        z-index: 9999;

        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 2.5rem;

        width: min(750px, calc(100% - 2rem));
        padding: 0.55rem 0.75rem 0.55rem 0.65rem;

        border: 1px solid rgb(var(--rgb-border-gray) / 0.14);
        border-radius: 9999px;

        background: rgb(var(--rgb-bg-base) / 0.68);
        box-shadow:
            0 12px 40px rgb(var(--rgb-bg-deep) / 0.35),
            inset 0 1px 0 rgb(var(--rgb-highlight) / 0.04);

        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);

        transform: translateX(-50%);

        box-sizing: border-box;
    }

    .brand {
        display: flex;
        align-items: center;
        gap: 0.75rem;

        min-width: max-content;

        color: inherit;
        text-decoration: none;
    }

    .brand-avatar {
        display: grid;
        place-items: center;

        width: 2.5rem;
        height: 2.5rem;

        border: 1px solid rgb(var(--rgb-accent-purple) / 0.25);
        border-radius: 9999px;

        background: linear-gradient(
            135deg,
            rgb(var(--rgb-accent-purple-deep) / 0.26),
            rgb(var(--rgb-accent-blue-deep) / 0.2)
        );

        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.05rem;
        color: rgb(var(--rgb-accent-purple-light));

        box-shadow: 0 0 22px rgb(var(--rgb-accent-purple-strong) / 0.12);
    }

    .brand-copy {
        display: flex;
        flex-direction: column;
        gap: 0.05rem;
    }

    .brand-name,
    .brand-role {
        margin: 0
    }

    .brand-name {
        font-size: 0.9rem;
        font-weight: 700;
        line-height: 1.2;
        color: rgb(var(--rgb-text-primary));
    }

    .brand-role {
        font-size: 0.7rem;
        line-height: 1.2;
        color: rgb(var(--rgb-text-muted));
    }

    .header-actions {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    nav {
        display: flex;
        align-items: center;
        gap: 0.25rem;
    }

    nav a {
        position: relative;

        padding: 0.7rem 0.95rem;
        border: 1px solid transparent;
        border-radius: 9999px;

        color: rgb(var(--rgb-text-nav));
        font-size: 0.85rem;
        font-weight: 500;
        text-decoration: none;

        transition:
            color 0.25s ease,
            border-color 0.25s ease,
            background-color 0.25s ease,
            transform 0.25s ease;
    }

    nav a:hover,
    nav a:focus-visible {
        color: rgb(var(--rgb-text-primary));
        border-color: rgb(var(--rgb-accent-purple) / 0.18);
        background: rgb(var(--rgb-accent-purple-strong) / 0.08);
        transform: translateY(-1px);
    }

    nav a:focus-visible {
        outline: 2px solid rgb(var(--rgb-accent-purple) / 0.55);
        outline-offset: 2px;
    }

    @media (max-width: 720px) {
        #header {
            top: 0.75rem;
            gap: 0.5rem;
            width: calc(100% - 1rem);
            padding: 0.45rem;
        }

        .brand-copy {
            display: none;
        }

        nav {
            flex: 1;
            justify-content: flex-end;
        }

        nav a {
            padding: 0.65rem 0.7rem;
            font-size: 0.78rem;
        }
    }

    @media (max-width: 480px) {
        nav a:first-child {
            display: none;
        }
    }

    .theme-toggle {
        display: grid;
        place-items: center;
        flex-shrink: 0;

        width: 2.5rem;
        height: 2.5rem;

        border: 1px solid rgb(var(--rgb-border-gray) / 0.14);
        border-radius: 9999px;

        background: rgb(var(--rgb-accent-purple-strong) / 0.08);
        color: rgb(var(--rgb-text-nav));
        cursor: pointer;

        transition:
            color 0.25s ease,
            border-color 0.25s ease,
            background-color 0.25s ease,
            transform 0.25s ease;
    }

    .theme-toggle:hover,
    .theme-toggle:focus-visible {
        color: rgb(var(--rgb-text-primary));
        border-color: rgb(var(--rgb-accent-purple) / 0.35);
        background: rgb(var(--rgb-accent-purple-strong) / 0.16);
        transform: translateY(-1px);
    }

    .theme-toggle:focus-visible {
        outline: 2px solid rgb(var(--rgb-accent-purple) / 0.55);
        outline-offset: 2px;
    }

    .theme-toggle svg {
        width: 1.15rem;
        height: 1.15rem;
    }

    .theme-toggle .icon-sun {
        display: none;
    }

    .theme-toggle .icon-moon {
        display: block;
    }

    :global(html[data-theme="light"]) .theme-toggle .icon-sun {
        display: block;
    }

    :global(html[data-theme="light"]) .theme-toggle .icon-moon {
        display: none;
    }
</style>




